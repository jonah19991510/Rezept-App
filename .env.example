# Kopiere diese Datei nach .env.local und trage die Werte ein.
# .env.local wird NICHT committet (steht in .gitignore).

# --- Supabase (Dashboard → Project Settings → API Keys) -----------------
# Öffentlich, landet im Browser. Durch RLS abgesichert.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# GEHEIM, nur serverseitig (Einladen, Nutzer löschen).
# Secret Key (sb_secret_...) oder Legacy-"service_role"-Key.
# Niemals mit NEXT_PUBLIC_ beginnen lassen, niemals committen.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App -----------------------------------------------------------------
# invite = nur auf Einladung (Standard), open = freie Registrierung
SIGNUP_MODE=invite

# Basis-URL für Links in E-Mails. Lokal http://localhost:3000,
# auf Vercel z. B. https://rezeptbuch.vercel.app (ohne Slash am Ende)
SITE_URL=http://localhost:3000
